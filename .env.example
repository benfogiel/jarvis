# Copy to .env and fill in. Variables already set in the shell take precedence.

# One of: anthropic, openai, gemini, groq, mistral, xai, deepseek, openrouter, together,
# ollama, lmstudio, openai-compatible
JARVIS_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required for every provider except anthropic.
# JARVIS_LLM_MODEL=

# Required for openai-compatible; overrides the endpoint for the others.
# JARVIS_LLM_BASE_URL=

# A different whisper.cpp ggml model file.
# JARVIS_WHISPER_MODEL=

# Voice. With a key and a voice ID the orb speaks through ElevenLabs; without them it uses the
# system voice. The voice ID is under "..." > "Copy voice ID" on a voice in the ElevenLabs library.
# ELEVENLABS_API_KEY=
# JARVIS_ELEVENLABS_VOICE=
# JARVIS_ELEVENLABS_MODEL=eleven_flash_v2_5

# Leave this out to use ElevenLabs. Setting it forces the system voice even with a key above.
# JARVIS_TTS_PROVIDER=system
